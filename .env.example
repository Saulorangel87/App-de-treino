# Ambiente local. Copie para .env e altere apenas na sua máquina.
POSTGRES_VERSION=17
POSTGRES_DB=cadencia_dev
POSTGRES_USER=cadencia
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

API_PORT=8080
# Pool de conexões do PostgreSQL (opcional).
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DATABASE_URL=postgres://cadencia:change-me-locally@localhost:5432/cadencia_dev?sslmode=disable
ALLOWED_ORIGIN=http://localhost:3000
# development | test | production. Em produção, APP_BASE_URL e ALLOWED_ORIGIN precisam ser https.
APP_ENV=development
SESSION_DAYS=7
APP_BASE_URL=http://localhost:3000
EMAIL_TOKEN_HOURS=24
# Em desenvolvimento, sem estas variáveis, os links ficam disponíveis apenas na resposta da API.
EMAIL_FROM=
RESEND_API_KEY=
# Opcional: destinatario do resumo semanal de feedback; deixe vazio em desenvolvimento.
FEEDBACK_DIGEST_TO=

# IA explicativa opcional. Desligada por padrão para não consumir recursos.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:4b-instruct
# Opcional: rota protegida do Worker Cloudflare usada somente como fallback.
AI_WORKER_URL=
AI_WORKER_TOKEN=
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=220
AI_MAX_CONCURRENT=1

# Proteção graduada do motor (dor e fadiga com validade e níveis). Desligada por
# padrão: com false, o motor segue a regra antiga de 28 dias.
PROTECTION_LEVELS_ENABLED=false

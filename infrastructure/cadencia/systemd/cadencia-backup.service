[Unit]
Description=Backup PostgreSQL do Cadência
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/home/ubuntu/apps/cadencia
Environment=CADENCIA_ENV_FILE=/home/ubuntu/apps/cadencia/infrastructure/cadencia/.env.production
Environment=CADENCIA_BACKUP_DIR=/var/backups/cadencia
Environment=CADENCIA_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/bin/bash /home/ubuntu/apps/cadencia/infrastructure/cadencia/scripts/backup-postgres.sh

FROM golang:1.25-alpine AS build

WORKDIR /src/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/cadencia-api ./cmd/api

FROM alpine:3.21

RUN apk add --no-cache ca-certificates wget \
    && addgroup -S cadencia \
    && adduser -S -G cadencia cadencia

COPY --from=build /out/cadencia-api /usr/local/bin/cadencia-api

USER cadencia
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/cadencia-api"]

FROM golang:1.26-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS build

WORKDIR /src/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/cadencia-api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/cadencia-feedback-digest ./cmd/feedback-digest
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/cadencia-account-export ./cmd/account-export

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache ca-certificates wget \
    && addgroup -S cadencia \
    && adduser -S -G cadencia cadencia

COPY --from=build /out/cadencia-api /usr/local/bin/cadencia-api
COPY --from=build /out/cadencia-feedback-digest /usr/local/bin/cadencia-feedback-digest
COPY --from=build /out/cadencia-account-export /usr/local/bin/cadencia-account-export

USER cadencia
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/cadencia-api"]

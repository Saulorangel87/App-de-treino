{
  "id": "/",
  "name": "Cadência — Treino inteligente",
  "short_name": "Cadência",
  "description": "Planejamento adaptativo de treinos de ciclismo baseado no seu perfil, recuperação e evolução.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eef1ea",
  "theme_color": "#eef1ea",
  "categories": [
    "fitness",
    "health",
    "sports"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/atividades/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".fit",
            ".gpx",
            "application/octet-stream",
            "application/gpx+xml",
            "application/vnd.ant.fit"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Treino de hoje",
      "short_name": "Hoje",
      "url": "/"
    },
    {
      "name": "Check-in de recuperação",
      "short_name": "Check-in",
      "url": "/recuperacao"
    },
    {
      "name": "Importar atividade",
      "short_name": "Importar",
      "url": "/atividades/importar"
    }
  ]
}

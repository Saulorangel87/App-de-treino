{
  "id": "/",
  "name": "Cadência — Treino inteligente",
  "short_name": "Cadência",
  "description": "Planejamento adaptativo de treinos de ciclismo baseado no seu perfil, recuperação e evolução.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f7f2",
  "theme_color": "#102d24",
  "categories": ["fitness", "health", "sports"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/atividades/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [".fit", ".gpx", "application/octet-stream", "application/gpx+xml", "application/vnd.ant.fit"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Visão geral",
      "short_name": "Painel",
      "url": "/"
    },
    {
      "name": "Perfil do atleta",
      "short_name": "Perfil",
      "url": "/perfil"
    }
  ]
}
